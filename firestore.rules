rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function teacher(){return signedIn()&&request.auth.token.role=='teacher'&&request.auth.token.teacher==true;}
  function student(){return signedIn()&&request.auth.token.role=='student'&&request.auth.token.groupId is int&&request.auth.token.groupId>=1&&request.auth.token.groupId<=5;}
  match /students/{uid}{
   allow read: if teacher()||(student()&&request.auth.uid==uid);
   allow create: if student()&&request.auth.uid==uid&&request.resource.data.uid==uid&&request.resource.data.groupId==request.auth.token.groupId&&request.resource.data.name is string&&request.resource.data.name.size()>=2&&request.resource.data.name.size()<=80&&request.resource.data.status=='active';
   allow update: if teacher()||(student()&&request.auth.uid==uid&&request.resource.data.uid==resource.data.uid&&request.resource.data.groupId==resource.data.groupId&&request.resource.data.name==resource.data.name&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastSeen','currentLesson','currentTask','taskId','progress','score','completedTasks','correctAnswers','incorrectAnswers','lastQuizResult','lastSubmittedTask'])&&(!('progress' in request.resource.data)||(request.resource.data.progress is number&&request.resource.data.progress>=0&&request.resource.data.progress<=100)));
   allow delete: if teacher();
  }
  match /submissions/{id}{
   allow read: if teacher()||(student()&&resource.data.uid==request.auth.uid);
   allow create,update: if student()&&request.resource.data.uid==request.auth.uid&&request.resource.data.groupId==request.auth.token.groupId&&request.resource.data.studentName is string&&request.resource.data.taskId is string&&request.resource.data.answer is string&&request.resource.data.answer.size()>0&&request.resource.data.answer.size()<=10000&&id==request.auth.uid+'_'+request.resource.data.taskId;
   allow delete: if teacher();
  }
  match /groupAnswers/{id}{
   allow read: if teacher()||(student()&&resource.data.groupId==request.auth.token.groupId);
   allow create,update: if student()&&request.resource.data.groupId==request.auth.token.groupId&&request.resource.data.taskId is string&&request.resource.data.text is string&&request.resource.data.text.size()<=12000&&request.resource.data.updatedBy==request.auth.uid;
   allow delete: if teacher();
  }
  match /assignments/{id}{allow read: if signedIn();allow write: if teacher();}
  match /groups/{id}{allow read: if signedIn();allow write: if teacher();}
 }
}